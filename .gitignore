# --- OS / editor ---
desktop.ini
Thumbs.db
.DS_Store

# --- Python / Jupyter ---
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environments ---
.venv/
venv/
env/

# --- Pipeline outputs ---
# Posterior chains (.npz + _meta.json) under results/ ARE versioned so anyone can
# rebuild tables and figures without re-running nested sampling.
# Generated figures under pipeline/*/figures/ and pipeline/*/results/figures/ ARE
# versioned alongside those runs (see generate_figures.py).
# Per-run dynesty logs (tests_logs/) and the parallel-sweep master log
# (pipeline/sweep_parallel_*.log) ARE also versioned for reproducibility.
# Regenerable papermill scratch stays ignored:
pipeline/**/tests_outputs/
**/tmp/
# --- Legacy exploratory outputs (regenerable; not versioned) ---
legacy/photoring/dev/prdata/*.csv
legacy/photoring/dev/prdata/figures/*.png

# --- Copyrighted reference PDFs (not redistributed) ---
bibliography/papers/
bibliography/*.pdf
legacy/*.pdf

# -- Contextual files --
context/

# --- LaTeX intermediates (papers/ only; keep manuscript PDFs trackable) ---
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.log
papers/**/*.out
papers/**/*.toc
papers/**/*.lof
papers/**/*.lot
papers/**/*.fls
