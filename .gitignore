# --- Pipeline outputs ---
# Posterior chains (.npz + _meta.json) under results/ ARE versioned so anyone can
# rebuild tables and figures without re-running nested sampling.
# Regenerable plotting / papermill scratch stay ignored:
pipeline/**/figures/
pipeline/**/tests_outputs/
pipeline/**/tests_logs/
**/tmp/
pipeline/sweep*.log
sweep*.log

# --- Legacy exploratory outputs (regenerable; not versioned) ---
legacy/photoring/dev/prdata/*.csv
legacy/photoring/dev/prdata/figures/*.png

# --- Copyrighted reference PDFs (not redistributed) ---
bibliography/papers/
bibliography/*.pdf
legacy/*.pdf

# -- Contextual files --
context/
