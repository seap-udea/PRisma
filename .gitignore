# --- Pipeline outputs (regenerated by running the pipeline, not versioned) ---
# Every case directory (pipeline/<case>/) regenerates these; inputs/ is kept.
pipeline/**/results/
pipeline/**/figures/
pipeline/**/tests_outputs/
pipeline/**/tests_logs/
**/tmp/
#
# NOTE: the posterior chains behind the manuscript figures are *not* here — they are
# versioned as reference artefacts under paper_figures/reference_runs/, because they are
# inputs to the paper reproduction rather than regenerable pipeline output.

# --- Legacy exploratory outputs (regenerable; not versioned) ---
legacy/photoring/dev/prdata/*.csv
legacy/photoring/dev/prdata/figures/*.png

# --- Copyrighted reference PDFs (not redistributed) ---
bibliography/papers/
bibliography/*.pdf
legacy/*.pdf
